+++ b/src/ocad-reader/rectangle-symbol.js
@@ -0,0 +1,48 @@
+const { Symbol10, Symbol11 } = require('./symbol')
+
+class RectangleSymbol10 extends Symbol10 {
+  constructor(reader) {
+    super(reader)
+    this.type = 7
+    this.lineColor = reader.readSmallInt()
+    this.lineWidth = reader.readSmallInt()
+    this.lineStyle = reader.readSmallInt()
+  }
+}
+
+// Field order per OOM's RectangleSymbolV11 (ocd_types_v11.h)
+class RectangleSymbol11 extends Symbol11 {
+  constructor(reader) {
+    super(reader)
+    // Symbol11 reads 64 fewer bytes than OOM's BaseSymbolV11 (description is 64 vs 128 bytes)
+    reader.skip(64)
+    this.type = 7
+    this.lineColor = reader.readWord()
+    this.lineWidth = reader.readWord()
+    this.cornerRadius = reader.readWord()
+    this.gridFlags = reader.readWord()
+    this.cellWidth = reader.readWord()
+    this.cellHeight = reader.readWord()
+    reader.skip(4) // reserved[2]
+    this.unnumberedCells = reader.readWord()
+    // Utf8PascalString<3>: 1 byte length + 3 bytes chars
+    const unnumLen = reader.readByte()
+    let unnumText = ''
+    for (let i = 0; i < 3; i++) {
+      const c = reader.readByte()
+      if (i < unnumLen) unnumText += String.fromCharCode(c)
+    }
+    this.unnumberedText = unnumText
+    this.lineStyle = reader.readWord()
+    reader.skip(32) // reserved Utf8PascalString<31>
+    reader.skip(2)  // reserved
+    this.fontSize = reader.readWord()
+  }
+}
+
+module.exports = {
+  10: RectangleSymbol10,
+  11: RectangleSymbol11,
+  12: RectangleSymbol11,
+  2018: RectangleSymbol11,
+}
