+// ponytail: word-wrap for formatted text frames; canvas measureText when available, else ~0.52em
+let _wrapCtx = null
+function wrapText(text, maxWidth, fontFamily, fontSize, italic, weight) {
+  const paragraphs = text.split('\n')
+  const lines = []
+  let ctx = _wrapCtx
+  if (!ctx && typeof OffscreenCanvas !== 'undefined') {
+    ctx = new OffscreenCanvas(1, 1).getContext('2d')
+    _wrapCtx = ctx
+  }
+  const fontStr = `${italic ? 'italic ' : ''}${weight > 400 ? 'bold ' : ''}${fontSize}px ${fontFamily}`
+  if (ctx) ctx.font = fontStr
+
+  for (const para of paragraphs) {
+    const words = para.split(/\s+/).filter(Boolean)
+    if (!words.length) { lines.push(''); continue }
+    let line = words[0]
+    for (let i = 1; i < words.length; i++) {
+      const test = line + ' ' + words[i]
+      const w = ctx
+        ? ctx.measureText(test).width
+        : test.length * fontSize * 0.52
+      if (w > maxWidth) {
+        lines.push(line)
+        line = words[i]
+      } else {
+        line = test
+      }
+    }
+    lines.push(line)
+  }
+  return lines
+}
